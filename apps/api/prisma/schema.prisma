generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum Size {
  S
  M
  L
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PromotionType {
  PERCENT
  FIXED
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  role                Role                 @default(CUSTOMER)
  loyaltyPoints       Int                  @default(0)
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  createdAt           DateTime             @default(now())
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  price      Int         // Đơn vị: VNĐ (VD: 35000)
  imageUrl   String
  stock      Int         @default(100)
  version    Int         @default(1) // Phục vụ Optimistic Locking (Task 10.3)
  orderItems OrderItem[]
}

model Order {
  id                  Int                  @id @default(autoincrement())
  userId              Int
  user                User                 @relation(fields: [userId], references: [id])
  status              OrderStatus          @default(PENDING)
  total               Int
  discount            Int                  @default(0)
  couponCode          String?
  promotionId         Int?
  promotion           Promotion?           @relation(fields: [promotionId], references: [id])
  loyaltyTransactions LoyaltyTransaction[]
  createdAt           DateTime             @default(now())
  items               OrderItem[]
  payments            Payment[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  size      Size     @default(M)
  toppings  String[] // Lưu danh sách topping: ["Trân châu", "Kem"]
  qty       Int
  lineTotal Int
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  order          Order         @relation(fields: [orderId], references: [id])
  idempotencyKey String        @unique // Đảm bảo Idempotent (Task 10.2)
  amount         Int
  method         PaymentMethod
  status         String        // SUCCESS | FAILED
  createdAt      DateTime      @default(now())
}

model Promotion {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  type      PromotionType
  value     Int           // Phần trăm hoặc số tiền VNĐ giảm
  validFrom DateTime?
  validTo   DateTime?
  active    Boolean       @default(true)
  orders    Order[]
  createdAt DateTime      @default(now())
}

model LoyaltyTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  orderId   Int?
  order     Order?   @relation(fields: [orderId], references: [id])
  points    Int
  createdAt DateTime @default(now())
}