# ==============================================================================
# BrewLite Unified Root .gitignore (Monorepo: Backend & Frontend)
# ==============================================================================

# Dependencies & Package Managers
node_modules/
.pnp
.pnp.*
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Compiled outputs & Production builds
dist/
build/
.next/
out/
.vercel

# TypeScript cache & environment declarations
*.tsbuildinfo
next-env.d.ts

# Logs & Debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Environment files
.env
.env*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temp directory & Runtime data
.temp/
.tmp/
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# IDEs & Editor files
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS & Certificates
.DS_Store
Thumbs.db
*.pem
