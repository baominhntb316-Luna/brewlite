# ==============================================================================
# BREWLITE ROOT ENVIRONMENT VARIABLES (.env)
# Tệp cấu hình môi trường dùng chung cho toàn bộ dự án (API + Web + Docker)
# ==============================================================================

# --- DATABASE & POSTGRES ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=brewlite
DATABASE_URL="postgresql://postgres:password123@localhost:5432/brewlite?schema=public"
DOCKER_DATABASE_URL="postgresql://postgres:password123@postgres:5432/brewlite?schema=public"

# --- BACKEND (apps/api) ---
PORT=3001
JWT_SECRET="brewlite-super-secret-key-2026"

# --- FRONTEND (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCK=false